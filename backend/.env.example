# ============================================================
# Backend Python do notas-pwa - MODELO do .env
# ============================================================
# Copie este arquivo para `backend/.env` e preencha os valores.
# O arquivo `backend/.env` NUNCA vai para o git (.gitignore).
#
# Sem nenhum valor preenchido o backend sobe em DRIVER=memory e o app continua
# 100% local (o PWA nao muda em nada). Preencha SUPABASE_* para ligar a nuvem.
# ============================================================

# --- Supabase (deixe vazio para rodar em memoria) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NUNCA vai para o front / sw.js / arquivos servidos: so o backend le isto.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_ANEXOS=anexos
# Opcional: conexao ao Postgres (permite ao `scripts/migrar.py` aplicar o
# schema.sql sem colar no SQL Editor). Pegue em Project Settings > Database >
# Connection string > "Session pooler". ATENCAO: o host direto `db.<ref>.supabase.co`
# e IPv6-only nos projetos novos - use o pooler (IPv4):
# Ex.: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# Se a senha tiver caracteres especiais, percent-encode (ex.: @ -> %40).
SUPABASE_DB_URL=

# --- Login com Google (Identity Services) ---
# Client ID PUBLICO do projeto no Google Cloud (APIs e servicos > Credenciais > ID do cliente
# OAuth). Deixe VAZIO para desligar: o botao "Entrar com Google" nem aparece no app.
# Nao ha `client_secret` aqui: o fluxo usa o ID token (validado no backend contra o JWKS do
# Google) e o `client_secret` NAO participa dele.
# Em "Origens JavaScript autorizadas" do Google Cloud, cadastre a origem do app
# (ex.: http://localhost:8000 e o dominio de producao).
GOOGLE_CLIENT_ID=

# --- Sessao (cookie httpOnly) ---
# String longa e aleatoria (ex.: python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSAO_SEGREDO=
SESSAO_COOKIE=py_session
# Validade em segundos (7 dias = 604800)
SESSAO_VALIDADE=604800
# Em producao (https) mude para true: o cookie passa a exigir Secure.
SESSAO_SEGURA=false
CSRF_HEADER=X-CSRF

# --- Anexos (Supabase Storage) ---
# Teto por ARQUIVO (seguranca/antiabuso) e cota por CONTA (o plano gratuito tem ~1 GB).
ANEXO_LIMITE_MB=25
ANEXO_COTA_MB=900

# --- Rede ---
# Origens aceitas para CORS/WebSocket (mesmo origin em dev nao precisa de CORS).
ORIGENS_PERMITIDAS=http://localhost:8000
HOST=127.0.0.1
PORTA=8000

# --- Driver: auto | supabase | memory ---
# "auto" usa supabase quando houver credenciais; senao memory.
DRIVER=auto

# --- Rate limit do login/registro (tentativas por janela, por IP+e-mail) ---
RATE_LIMITE=5
RATE_JANELA=60
