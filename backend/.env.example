# ============================================================
# Backend Python do notas-pwa - MODELO do .env
# ============================================================
# Copie este arquivo para `backend/.env` e preencha os valores.
# O arquivo `backend/.env` NUNCA vai para o git (.gitignore).
#
# Sem nenhum valor preenchido o backend sobe em DRIVER=memory e o app continua
# 100% local (o PWA nao muda em nada). Preencha SUPABASE_* para ligar a nuvem.
# ============================================================

# --- Supabase (deixe vazio para rodar em memoria) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NUNCA vai para o front / sw.js / arquivos servidos: so o backend le isto.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_ANEXOS=anexos
# Opcional: conexao DIRETA ao Postgres (permite ao `scripts/migrar.py` aplicar o
# schema.sql sem colar no SQL Editor). Pegue em Project Settings > Database.
# Ex.: postgresql://postgres:<senha>@db.<projeto>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# --- Sessao (cookie httpOnly) ---
# String longa e aleatoria (ex.: python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSAO_SEGREDO=
SESSAO_COOKIE=py_session
# Validade em segundos (7 dias = 604800)
SESSAO_VALIDADE=604800
# Em producao (https) mude para true: o cookie passa a exigir Secure.
SESSAO_SEGURA=false
CSRF_HEADER=X-CSRF

# --- Rede ---
# Origens aceitas para CORS/WebSocket (mesmo origin em dev nao precisa de CORS).
ORIGENS_PERMITIDAS=http://localhost:8000
HOST=127.0.0.1
PORTA=8000

# --- Driver: auto | supabase | memory ---
# "auto" usa supabase quando houver credenciais; senao memory.
DRIVER=auto

# --- Rate limit do login/registro (tentativas por janela, por IP+e-mail) ---
RATE_LIMITE=5
RATE_JANELA=60
